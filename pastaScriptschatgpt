local function CreateToggle(parent, text, default, callback)
    local btn = Instance.new("TextButton", parent); btn.Size = UDim2.new(1, 0, 0, 28); btn.BackgroundTransparency = 1; btn.Text = "  [ " .. (default and "X" or " ") .. " ] " .. text; btn.TextColor3 = default and Color3.new(1,1,1) or Color3.new(0.6,0.6,0.6); btn.TextSize = 14; btn.Font = 3; btn.TextXAlignment = 0
