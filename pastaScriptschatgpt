local function CreateSlider(parent, text, min, max, default, callback)
    local container = Instance.new("Frame", parent)
    container.Size             = UDim2.new(1, 0, 0, 38)
    container.BackgroundTransparency = 1

    local label = Instance.new("TextLabel", container)
    label.Text           = "  " .. text .. ": " .. default
    label.Size           = UDim2.new(1, 0, 0, 16)
    label.TextColor3     = Color3.new(0.6, 0.6, 0.6)
    label.TextSize       = 14
    label.Font           = Enum.Font.Code
    label.BackgroundTransparency = 1
    label.TextXAlignment = Enum.TextXAlignment.Left

    local bg = Instance.new("Frame", container)
    bg.Size             = UDim2.new(0.85, 0, 0, 4)
    bg.Position         = UDim2.new(0.05, 0, 0, 22)
    bg.BackgroundColor3= Color3.fromRGB(45, 45, 45)
    bg.BorderSizePixel = 0
    Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame", bg)
    fill.Size             = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3= Color3.new(0.8, 0.8, 0.8)
    fill.BorderSizePixel = 0
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local hitArea = Instance.new("TextButton", container)
    hitArea.Size             = UDim2.new(0.85, 0, 0, 20)
    hitArea.Position         = UDim2.new(0.05, 0, 0, 14)
    hitArea.BackgroundTransparency = 1
    hitArea.Text             = ""

    local dragging = false
    local function applyValue(screenX)
        local rel = math.clamp((screenX - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local val
        if (max - min) > 10 then val = math.floor(min + (max - min) * rel)
        else val = math.floor((min + (max - min) * rel) * 10) / 10 end
        fill.Size  = UDim2.new(rel, 0, 1, 0)
        label.Text = "  " .. text .. ": " .. val
        safe(callback, val)
    end

    hitArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            Settings.IsDraggingSlider = true
            applyValue(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then applyValue(input.Position.X) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then
            dragging = false
            Settings.IsDraggingSlider = false
        end
    end)
    return container
end

