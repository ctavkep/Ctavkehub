end

local function CreateSlider(parent, text, min, max, default, callback)
    local container = Instance.new("Frame", parent); container.Size = UDim2.new(1, 0, 0, 35); container.BackgroundTransparency = 1
    local label = Instance.new("TextLabel", container); label.Text = "  " .. text .. ": " .. default; label.Size = UDim2.new(1,0,0,16); label.TextColor3 = Color3.new(0.6,0.6,0.6); label.TextSize = 14; label.BackgroundTransparency = 1; label.TextXAlignment = 0
    local bg = Instance.new("Frame", container); bg.Size = UDim2.new(0.7,0,0,2); bg.Position = UDim2.new(0.05,0,0.75,0); bg.BackgroundColor3 = Color3.fromRGB(45,45,45)
    local fill = Instance.new("Frame", bg); fill.Size = UDim2.new((default-min)/(max-min),0,1,0); fill.BackgroundColor3 = Color3.new(0.8,0.8,0.8); fill.BorderSizePixel = 0
    local dragging = false
    local function update(input)
        local pos = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local val = min + (max-min)*pos
        if max > 10 then val = math.floor(val) else val = math.floor(val * 10) / 10 end
        fill.Size = UDim2.new(pos,0,1,0); label.Text = "  " .. text .. ": " .. val; callback(val)
    end
    bg.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; Settings.IsDraggingSlider = true; update(input) end end)
    UserInputService.InputChanged:Connect(function(input) if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false; Settings.IsDraggingSlider = false end end)
end

