-- ──────────────────── AUTO FIRE (SILENT RETURN) ───────────────────────── --
local function DoAutoFire(target)
    if Settings.IsFiring then return end
    if not target or not target.Parent then return end
    Settings.IsFiring = true
    Settings.LastShotTime = tick()
    local ok = pcall(function()
        -- Сохраняем CFrame ДО рывка камеры
        local originalCFrame = Camera.CFrame

        -- Наводим камеру на цель
        local lookTarget = GetAimLookTarget(target.Position)
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, lookTarget)
        task.wait(0.01)

        if target and target.Parent then
            if mouse1press then
                mouse1press()
                task.wait(0.01)
                mouse1release()
            else
                local char = LocalPlayer.Character
                if char then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool then safe(function() tool:Activate() end) end
                end
            end
        end

        -- Запускаем плавный silent return к исходной позиции камеры
        Settings.SilentReturnCFrame = originalCFrame
        Settings.SilentReturnFrames = 5
    end)
    Settings.IsFiring = false
end

-- ──── Silent Return: плавно возвращает камеру после автовыстрела ─────── --
-- Запускается ПОСЛЕ системы камеры (Camera+2), чтобы не конфликтовать
RunService:BindToRenderStep("HVH_SilentReturn", Enum.RenderPriority.Camera.Value + 2, function()
    if not (Settings.SilentReturnCFrame and Settings.SilentReturnFrames > 0) then return end

    -- Прерываем если началась новая стрельба
    if Settings.IsFiring then
        Settings.SilentReturnCFrame = nil
        Settings.SilentReturnFrames = 0
        return
    end

    Settings.SilentReturnFrames = Settings.SilentReturnFrames - 1

    -- Если игрок зажал мышь — не перебиваем его прицел, просто тикаем счётчик
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        -- alpha 0.6: ~99% возврата за 5 кадров (~83мс на 60fps) — почти незаметно
        Camera.CFrame = Camera.CFrame:Lerp(Settings.SilentReturnCFrame, 0.6)
    end

    if Settings.SilentReturnFrames <= 0 then
        Settings.SilentReturnCFrame = nil
    end
end)

-- ─────────────────── ANTI-AIM & TP ─────────────────────────────────────── --
local wasJittering = false
RunService:BindToRenderStep("HVH_AntiAim_TP", Enum.RenderPriority.Camera.Value + 1, function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    if Settings.JitterEnabled or Settings.TP_Enabled then
        local camCF = Camera.CFrame
        local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)

        if flatLook.Magnitude > 0.1 then
            flatLook = flatLook.Unit
            local yOffset = 0

            if Settings.JitterEnabled then
                if hum.AutoRotate then hum.AutoRotate = false end
                wasJittering = true
                local offset = (math.sin(tick() * Settings.JitterSpeed) > 0) and Settings.JitterDegree or -Settings.JitterDegree
                yOffset = math.pi + math.rad(offset)
            else
                if wasJittering then
                    hum.AutoRotate = true
                    wasJittering = false
                end
            end

            root.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook) * CFrame.Angles(0, yOffset, 0)
        end
    else
        if wasJittering then
            hum.AutoRotate = true
            wasJittering = false
        end
    end
end)

-- ─────────────────────── MAIN LOOP ────────────────────────────────────── --
RunService.RenderStepped:Connect(function()
    safe(UpdateESP)

    -- THIRD PERSON LOGIC
    if Settings.TP_Enabled then
        safe(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
                LocalPlayer.CameraMaxZoomDistance = Settings.TP_Distance
                LocalPlayer.CameraMinZoomDistance = Settings.TP_Distance

                -- ФИКС: меню открыто → курсор свободен; меню закрыто → TP работает нормально
                if MainFrame.Visible then
                    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
                else
                    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                end

                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.LocalTransparencyModifier = Settings.TP_Transparency end
                end
                for _, obj in pairs(Camera:GetChildren()) do
                    if obj:IsA("Model") or obj:IsA("BasePart") then
                        for _, p in pairs(obj:GetDescendants()) do
                            if p:IsA("BasePart") then p.LocalTransparencyModifier = 1 end
                        end
                    end
                end
            end
        end)
    end

    if not Settings.AimbotEnabled then return end
    circle.Size = UDim2.new(0, Settings.FOV_RADIUS * 2, 0, Settings.FOV_RADIUS * 2)
    local target, minDist = nil, Settings.FOV_RADIUS
    local viewCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        safe(function()
            if not p.Character then return end
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end
            if Settings.AimbotTeamCheck and p.Team == LocalPlayer.Team then return end
            local part = getBestPart(p.Character)
            if not part then return end
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then return end
            local mag = (Vector2.new(pos.X, pos.Y) - viewCenter).Magnitude
            if mag < minDist then minDist = mag; target = part end
        end)
    end

    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and target then
        safe(function()
            -- Отменяем silent return если игрок сам зажал мышь
            Settings.SilentReturnCFrame = nil
            Settings.SilentReturnFrames = 0
            local lookTarget = GetAimLookTarget(target.Position)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, lookTarget)
            Settings.isSnapped = true
        end)
    else
        Settings.isSnapped = false
    end

    if Settings.AutoFire and target and not Settings.IsFiring then
        if (tick() - Settings.LastShotTime) >= Settings.FIRE_RATE then
            if IsVisible(target, target.Parent) then task.spawn(DoAutoFire, target) end
        end
    end
    safe(function() stroke.Color = target and Color3.new(0,1,0) or Color3.new(0,1,1) end)
end)

