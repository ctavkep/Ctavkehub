-- [[ УЛЬТРА-ПРОВЕРКА ВИДИМОСТИ (PEEK FIX) ]] --
local function IsVisible(part, targetCharacter)
    if not Settings.AimbotWallCheck then return true end
    
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("Head") then return false end
    
    -- 1. Проверка от Камеры (видит ли игрок цель)
    local camOrigin = Camera.CFrame.Position
    -- 2. Проверка от Головы персонажа (высунулся ли персонаж из-за стены)
    local charOrigin = character.Head.Position

    local targetPos = part.Position
    
    -- Параметры луча
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character, targetCharacter, Camera}
    params.IgnoreWater = true
    
    -- Проверка 1: Камера -> Цель
    local resCam = workspace:Raycast(camOrigin, targetPos - camOrigin, params)
    
    -- Проверка 2: Голова персонажа -> Цель (тот самый фикс с видео)
    local resChar = workspace:Raycast(charOrigin, targetPos - charOrigin, params)
    
    -- Если FixAim включен, нам нужно, чтобы ОБА луча были чистыми.
    -- Это значит, что ты не выстрелишь, пока пушка не выйдет из-за стены.
    if Settings.FixAim then
        return (resCam == nil) and (resChar == nil)
    else
        return resCam == nil
    end
end

local function getBestPart(character)
    if Settings.TARGET_PART ~= "All" then
        local pName = Settings.TARGET_PART
        if pName == "Random" then pName = PriorityParts[math.random(1, 3)] end
        local p = character:FindFirstChild(pName)
        return (p and IsVisible(p, character)) and p or nil
    end
    for _, name in ipairs(PriorityParts) do
        local p = character:FindFirstChild(name)
        if p and IsVisible(p, character) then return p end
    end
    return nil
end

-- [[ ESP LOGIC ]] --
local function GetESPData(player)
    if not ESP_CACHE[player] then
        ESP_CACHE[player] = { Name = Drawing.new("Text"), Health = Drawing.new("Text") }
    end
    return ESP_CACHE[player]
end

local function RemoveESP(player)
    if ESP_CACHE[player] then
        if ESP_CACHE[player].Name then ESP_CACHE[player].Name:Remove() end
        if ESP_CACHE[player].Health then ESP_CACHE[player].Health:Remove() end
        ESP_CACHE[player] = nil
    end
end
Players.PlayerRemoving:Connect(RemoveESP)

local function UpdateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local data = GetESPData(p)

        if Settings.ESPEnabled and head and hum and hum.Health > 0 then
            local isTeam = (p.Team == LocalPlayer.Team)
            if Settings.ESPTeamCheck and isTeam then
                data.Name.Visible = false; data.Health.Visible = false
                if char:FindFirstChild("OBKAK_Highlight") then char.OBKAK_Highlight.Enabled = false end
                continue
            end

            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
            local dist = (Camera.CFrame.Position - head.Position).Magnitude

            if onScreen and dist <= Settings.MaxDistance then
                local color = isTeam and Color3.new(0,1,0) or Color3.new(1,0,0)
                if Settings.ShowNames then
                    data.Name.Text = p.Name; data.Name.Position = Vector2.new(pos.X, pos.Y - 30); data.Name.Color = color; data.Name.Visible = true; data.Name.Outline = true; data.Name.Size = 14
                else data.Name.Visible = false end
                if Settings.ShowHealth then
                    data.Health.Text = "HP: " .. math.floor(hum.Health); data.Health.Position = Vector2.new(pos.X, pos.Y - 15); data.Health.Color = Color3.new(1,1,1); data.Health.Visible = true; data.Health.Outline = true; data.Health.Size = 13
                else data.Health.Visible = false end
                if Settings.ShowChams then
                    local h = char:FindFirstChild("OBKAK_Highlight") or Instance.new("Highlight", char)
                    h.Name = "OBKAK_Highlight"; h.Enabled = true; h.FillColor = color; h.FillTransparency = Settings.ChamsTransparency
                elseif char:FindFirstChild("OBKAK_Highlight") then char.OBKAK_Highlight.Enabled = false end
            else data.Name.Visible = false; data.Health.Visible = false end
        else
            data.Name.Visible = false; data.Health.Visible = false
            if char and char:FindFirstChild("OBKAK_Highlight") then char.OBKAK_Highlight.Enabled = false end
        end
    end
end

