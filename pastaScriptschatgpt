        return
    end

    circle.Size = UDim2.new(0, Settings.FOV_RADIUS * 2, 0, Settings.FOV_RADIUS * 2)
    local target, minDist = nil, Settings.FOV_RADIUS
    local viewCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        safe(function()
            if not p.Character then return end
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return end
            if Settings.AimbotTeamCheck and p.Team == LocalPlayer.Team then return end
            local part = getBestPart(p.Character)
            if not part then return end
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if not onScreen then return end
            local mag = (Vector2.new(pos.X, pos.Y) - viewCenter).Magnitude
            if mag < minDist then minDist = mag; target = part end
        end)
    end

    -- ── Отменить pre-fire если цель сменилась ─────────────────────────────
    if Settings._prefireActive and Settings._prefireTarget ~= target then
        if Settings._prefireOriginalCF then
            Settings.SilentReturnCFrame = Settings._prefireOriginalCF
            Settings.SilentReturnFrames = 5
        end
        Settings._prefireActive   = false
        Settings._prefireTarget   = nil
        Settings._prefireFrames   = 0
        Settings._prefireOriginalCF = nil
    end

    -- ── Manual Aim (LMB зажат) ─────────────────────────────────────────────
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and target then
        safe(function()
            if Settings._prefireActive then
                Settings._prefireActive   = false
                Settings._prefireTarget   = nil
                Settings._prefireFrames   = 0
                Settings._prefireOriginalCF = nil
            end
            Settings.SilentReturnCFrame = nil
            Settings.SilentReturnFrames = 0
            local lookTarget = GetAimLookTarget(target.Position)
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, lookTarget)
            Settings.isSnapped = true
        end)
    else
        Settings.isSnapped = false

        -- ── Adaptive: проверяем результат предыдущего выстрела ────────────
        safe(function()
            if Settings._shotCheckTarget then
                if not Settings._shotCheckTarget.Parent then
                    -- Цель исчезла (убита) → попали → уменьшаем задержку
                    Settings._adaptiveStability = math.max(Settings._adaptiveMin, Settings._adaptiveStability - 1)
                    Settings._shotCheckTarget = nil
                elseif (tick() - Settings._shotCheckTime) >= 0.2 then
                    local hum = Settings._shotCheckTarget.Parent:FindFirstChildOfClass("Humanoid")
                    if hum then
                        if hum.Health < Settings._shotCheckHealth - 1 then
                            -- Урон прошёл → успех → уменьшаем задержку (стрелять быстрее)
                            Settings._adaptiveStability = math.max(Settings._adaptiveMin, Settings._adaptiveStability - 1)
                        else
                            -- Урона нет → возможно промах → увеличиваем задержку (держать дольше)
                            Settings._adaptiveStability = math.min(Settings._adaptiveMax, Settings._adaptiveStability + 1)
                        end
                    end
                    Settings._shotCheckTarget = nil
                end
            end
        end)

        -- ── AutoFire с адаптивным pre-fire ───────────────────────────────
        if Settings.AutoFire then

            if Settings._prefireActive and not Settings.IsFiring then
                local t = Settings._prefireTarget
                if t and t.Parent then
                    -- Снапаем камеру каждый фрейм чтобы игра видела прицел N фреймов подряд
                    safe(function()
                        if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                            local lookTarget = GetAimLookTarget(t.Position)
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, lookTarget)
                        end
                    end)

                    -- Считаем фреймы удержания прицела
                    Settings._prefireFrames = Settings._prefireFrames + 1

                    local stabilityNeeded = Settings.AdaptiveFireEnabled
                        and Settings._adaptiveStability
                        or Settings.ManualStabilityFrames

                    -- Таймаут 400мс — принудительный выстрел на случай зависания
                    local timeout = (tick() - Settings._prefireStartTime) >= 0.4

                    if Settings._prefireFrames >= stabilityNeeded or timeout then
                        -- Записываем HP для адаптивной проверки
                        safe(function()
                            local hum = t.Parent:FindFirstChildOfClass("Humanoid")
                            if hum and hum.Health > 0 then
                                Settings._shotCheckTarget = t
                                Settings._shotCheckTime   = tick()
                                Settings._shotCheckHealth = hum.Health
                            end
                        end)

                        local originalCF = Settings._prefireOriginalCF
                        Settings._prefireActive   = false
                        Settings._prefireTarget   = nil
                        Settings._prefireFrames   = 0
                        Settings._prefireOriginalCF = nil

                        if IsVisible(t, t.Parent) then
                            task.spawn(DoAutoFirePreSnapped, originalCF)
                        else
                            -- Цель закрылась стеной — возвращаем камеру
                            if originalCF then
                                Settings.SilentReturnCFrame = originalCF
                                Settings.SilentReturnFrames = 5
                            end
                        end
                    end

                else
                    -- Цель пропала во время pre-fire
                    if Settings._prefireOriginalCF then
                        Settings.SilentReturnCFrame = Settings._prefireOriginalCF
                        Settings.SilentReturnFrames = 5
                    end
                    Settings._prefireActive   = false
                    Settings._prefireTarget   = nil
                    Settings._prefireFrames   = 0
                    Settings._prefireOriginalCF = nil
                end

            elseif target and not Settings.IsFiring and not Settings._prefireActive then
                if (tick() - Settings.LastShotTime) >= Settings.FIRE_RATE then
                    if IsVisible(target, target.Parent) then
                        -- ── Запускаем pre-fire: сохраняем позицию и снапаем ──
                        Settings._prefireOriginalCF = Camera.CFrame
                        local lookTarget = GetAimLookTarget(target.Position)
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, lookTarget)
                        Settings._prefireActive   = true
                        Settings._prefireTarget   = target
                        Settings._prefireFrames   = 0
                        Settings._prefireStartTime = tick()
                    end
                end
            end
        end
    end

    safe(function() stroke.Color = target and Color3.new(0,1,0) or Color3.new(0,1,1) end)
end)

-- ─────────────────────── UI DRAG ──────────────────────────────────────────
local dragStart, startPos, isDragging = nil, nil, false
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 and not Settings.IsDraggingSlider then
        isDragging = true dragStart = input.Position startPos = MainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement and dragStart then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then isDragging = false end end)
UserInputService.InputBegan:Connect(function(input, gpe) if not gpe and input.KeyCode == Enum.KeyCode.Insert then MainFrame.Visible = not MainFrame.Visible end end)

aimPage.Visible = true
aimBtn.TextColor3 = Color3.new(1, 1, 1)
aimBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
