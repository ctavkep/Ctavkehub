-- [[ ЛОГИКА ESP ]] --
local function IsEnemy(player)
    if not Settings.ESPTeamCheck then return true end
    return LocalPlayer.Team ~= player.Team
end

local function GetColor(player)
    return IsEnemy(player) and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(60, 255, 60)
end

local function RemoveESP(player)
    if ESP_DATA[player] then
        for _, obj in pairs(ESP_DATA[player]) do pcall(function() obj:Remove() end) end
        ESP_DATA[player] = nil
    end
    if CHAMS_DATA[player] then pcall(function() CHAMS_DATA[player]:Destroy() end); CHAMS_DATA[player] = nil end
end

local function CreateESP(player)
    if ESP_DATA[player] then return end
    local name = Drawing.new("Text"); name.Center = true; name.Outline = true; name.Font = 2; name.Visible = false
    local health = Drawing.new("Text"); health.Center = true; health.Outline = true; health.Font = 2; health.Visible = false
    ESP_DATA[player] = {Name = name, Health = health}
end

local function CreateChams(player)
    local char = player.Character
    if not char then return end
    local highlight = char:FindFirstChild("OBKAK_Highlight") or Instance.new("Highlight")
    highlight.Name = "OBKAK_Highlight"
    highlight.Adornee = char
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = Settings.ChamsTransparency
    highlight.Enabled = false
    highlight.Parent = char
    CHAMS_DATA[player] = highlight
end

local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local data = ESP_DATA[player]
        if not data then CreateESP(player); continue end

        local char = player.Character
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if Settings.ESPEnabled and head and hum and hum.Health > 0 and (not Settings.OnlyEnemies or IsEnemy(player)) then
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            local dist = (Camera.CFrame.Position - head.Position).Magnitude

            if onScreen and dist <= Settings.MaxDistance then
                local color = GetColor(player)
                if Settings.ShowNames then
                    data.Name.Text = player.Name; data.Name.Color = color; data.Name.Position = Vector2.new(screenPos.X, screenPos.Y - 30); data.Name.Visible = true; data.Name.Size = 14
                else data.Name.Visible = false end

                if Settings.ShowHealth then
                    data.Health.Text = "❤ " .. math.floor(hum.Health); data.Health.Color = Color3.fromHSV(math.clamp(hum.Health/hum.MaxHealth, 0, 1) * 0.3, 1, 1); data.Health.Position = Vector2.new(screenPos.X, screenPos.Y - 15); data.Health.Visible = true; data.Health.Size = 12
                else data.Health.Visible = false end

                if Settings.ShowChams and char then
                    if not CHAMS_DATA[player] then CreateChams(player) end
                    local h = CHAMS_DATA[player]
                    if h then h.Enabled = true; h.FillColor = color; h.OutlineColor = color end
                elseif CHAMS_DATA[player] then CHAMS_DATA[player].Enabled = false end
            else
                data.Name.Visible = false; data.Health.Visible = false
                if CHAMS_DATA[player] then CHAMS_DATA[player].Enabled = false end
            end
        else
            data.Name.Visible = false; data.Health.Visible = false
            if CHAMS_DATA[player] then CHAMS_DATA[player].Enabled = false end
        end
    end
end

-- [[ ЛОГИКА AIMBOT ]] --
local function getAimbotTarget()
    local target, minDist = nil, Settings.FOV_RADIUS
    local partName = Settings.TARGET_PART
    if partName == "Random" then partName = ({"Head", "UpperTorso", "LowerTorso"})[math.random(1,3)] end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild(partName) then
            if Settings.AimbotTeamCheck and p.Team == LocalPlayer.Team then continue end
            local part = p.Character[partName]
            local visible = true
            if Settings.AimbotWallCheck then
                local ray = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, RaycastParams.new())
                if ray and not ray.Instance:IsDescendantOf(p.Character) then visible = false end
            end
            if visible then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local mag = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                    if mag < minDist then minDist = mag; target = part end
                end
            end
        end
    end
    return target
end

-- [[ ГЛАВНЫЙ ЦИКЛ ]] --
RunService.RenderStepped:Connect(function()
    UpdateESP()
    
    if Settings.AimbotEnabled then
        circle.Size = UDim2.new(0, Settings.FOV_RADIUS * 2, 0, Settings.FOV_RADIUS * 2)
        local target = getAimbotTarget()
        local currentTime = tick()
        
        -- Silent Aim logic
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and target then
            if not Settings.isSnapped then
                local targetCF = CFrame.new(Camera.CFrame.Position, target.Position)
                Settings.snapOffset = targetCF:ToObjectSpace(Camera.CFrame)
                Camera.CFrame = targetCF
                Settings.isSnapped = true
            else
                Camera.CFrame = Camera.CFrame:ToWorldSpace(Settings.snapOffset)
                Settings.isSnapped = false
            end
        else Settings.isSnapped = false end

        -- Auto Fire
        if Settings.AutoFire and target and (currentTime - Settings.LastShotTime >= Settings.FIRE_RATE) then
            Settings.LastShotTime = currentTime
            local oldCF = Camera.CFrame
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            if mouse1press then mouse1press(); task.wait(0.02); mouse1release()
            else local t = LocalPlayer.Character:FindFirstChildOfClass("Tool"); if t then t:Activate() end end
            task.defer(function() Camera.CFrame = oldCF end)
        end
        circle.UIStroke.Color = target and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(0, 255, 255)
    end
end)

