-- ─────────────────── AUTO FIRE: Pre-Snapped Shot ─────────────────────────
-- Камера уже направлена на цель из pre-fire фазы — просто стреляем
local function DoAutoFirePreSnapped(originalCF)
    if Settings.IsFiring then return end
    Settings.IsFiring = true
    Settings.LastShotTime = tick()
    pcall(function()
        if mouse1press then
            mouse1press()
            task.wait(0.01)
            mouse1release()
        else
            local char = LocalPlayer.Character
            if char then
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then safe(function() tool:Activate() end) end
            end
        end
        if originalCF then
            Settings.SilentReturnCFrame = originalCF
            Settings.SilentReturnFrames = 5
        end
    end)
    Settings.IsFiring = false
end

-- ─────────────────── Silent Return ────────────────────────────────────────
RunService:BindToRenderStep("HVH_SilentReturn", Enum.RenderPriority.Camera.Value + 2, function()
    if not (Settings.SilentReturnCFrame and Settings.SilentReturnFrames > 0) then return end
    if Settings.IsFiring then
        Settings.SilentReturnCFrame = nil
        Settings.SilentReturnFrames = 0
        return
    end
    Settings.SilentReturnFrames = Settings.SilentReturnFrames - 1
    if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        Camera.CFrame = Camera.CFrame:Lerp(Settings.SilentReturnCFrame, 0.6)
    end
    if Settings.SilentReturnFrames <= 0 then
        Settings.SilentReturnCFrame = nil
    end
end)

-- ─────────────────── Anti-Aim & TP ────────────────────────────────────────
local wasJittering = false
RunService:BindToRenderStep("HVH_AntiAim_TP", Enum.RenderPriority.Camera.Value + 1, function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return end

    if Settings.JitterEnabled or Settings.TP_Enabled then
        local camCF = Camera.CFrame
        local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
        if flatLook.Magnitude > 0.1 then
            flatLook = flatLook.Unit
            local yOffset = 0
            if Settings.JitterEnabled then
                if hum.AutoRotate then hum.AutoRotate = false end
                wasJittering = true
                local offset = (math.sin(tick() * Settings.JitterSpeed) > 0) and Settings.JitterDegree or -Settings.JitterDegree
                yOffset = math.pi + math.rad(offset)
            else
                if wasJittering then hum.AutoRotate = true; wasJittering = false end
            end
            root.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook) * CFrame.Angles(0, yOffset, 0)
        end
    else
        if wasJittering then hum.AutoRotate = true; wasJittering = false end
    end
end)

