-- [[ ЛОГИКА ESP ]] --
local function GetESPData(player)
    if not ESP_CACHE[player] then
        ESP_CACHE[player] = {
            Name = Drawing.new("Text"),
            Health = Drawing.new("Text")
        }
    end
    return ESP_CACHE[player]
end

local function CleanESP(player)
    if ESP_CACHE[player] then
        ESP_CACHE[player].Name.Visible = false
        ESP_CACHE[player].Health.Visible = false
    end
end

local function UpdateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local data = GetESPData(p)
        local char = p.Character
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if Settings.ESPEnabled and head and hum and hum.Health > 0 then
            local isTeam = (p.Team == LocalPlayer.Team)
            if Settings.ESPTeamCheck and isTeam then
                CleanESP(p)
                if char:FindFirstChild("OBKAK_Highlight") then char.OBKAK_Highlight.Enabled = false end
                continue
            end

            local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
            local dist = (Camera.CFrame.Position - head.Position).Magnitude

            if onScreen and dist <= Settings.MaxDistance then
                local color = isTeam and Color3.new(0,1,0) or Color3.new(1,0,0)
                
                -- Имена
                if Settings.ShowNames then
                    data.Name.Text = p.Name; data.Name.Position = Vector2.new(pos.X, pos.Y - 30); data.Name.Color = color; data.Name.Visible = true; data.Name.Outline = true; data.Name.Size = 14
                else data.Name.Visible = false end

                -- Здоровье
                if Settings.ShowHealth then
                    data.Health.Text = "❤ " .. math.floor(hum.Health); data.Health.Position = Vector2.new(pos.X, pos.Y - 15); data.Health.Color = Color3.fromHSV(math.clamp(hum.Health/hum.MaxHealth, 0, 1) * 0.3, 1, 1); data.Health.Visible = true; data.Health.Outline = true; data.Health.Size = 13
                else data.Health.Visible = false end

                -- Чамсы (Highlight)
                if Settings.ShowChams then
                    local h = char:FindFirstChild("OBKAK_Highlight") or Instance.new("Highlight", char)
                    h.Name = "OBKAK_Highlight"; h.Enabled = true; h.FillColor = color; h.FillTransparency = Settings.ChamsTransparency; h.OutlineColor = Color3.new(1,1,1)
                elseif char:FindFirstChild("OBKAK_Highlight") then char.OBKAK_Highlight.Enabled = false end
            else CleanESP(p) end
        else
            CleanESP(p)
            if char and char:FindFirstChild("OBKAK_Highlight") then char.OBKAK_Highlight.Enabled = false end
        end
    end
end

-- [[ ЛОГИКА AIM ]] --
local function IsVisible(part, character)
    if not Settings.AimbotWallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, character, Camera}
    local ray = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
    return (not ray) or (ray.Instance.Transparency > 0.4)
end

local function getBestPart(character)
    if Settings.TARGET_PART ~= "All" then
        local pName = Settings.TARGET_PART
        if pName == "Random" then pName = PriorityParts[math.random(1, 3)] end
        local p = character:FindFirstChild(pName)
        return (p and IsVisible(p, character)) and p or nil
    end
    for _, name in ipairs(PriorityParts) do
        local p = character:FindFirstChild(name)
        if p and IsVisible(p, character) then return p end
    end
    return nil
end

RunService.RenderStepped:Connect(function()
    UpdateESP()

    if not Settings.AimbotEnabled then return end
    circle.Size = UDim2.new(0, Settings.FOV_RADIUS * 2, 0, Settings.FOV_RADIUS * 2)
    local target, minDist = nil, Settings.FOV_RADIUS

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                if Settings.AimbotTeamCheck and p.Team == LocalPlayer.Team then continue end
                local part = getBestPart(p.Character)
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local mag = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                        if mag < minDist then minDist = mag; target = part end
                    end
                end
            end
        end
    end

    -- Silent Aim
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and target then
        if not Settings.isSnapped then
            local tCF = CFrame.new(Camera.CFrame.Position, target.Position)
            Settings.snapOffset = tCF:ToObjectSpace(Camera.CFrame)
            Camera.CFrame = tCF; Settings.isSnapped = true
        else
            Camera.CFrame = Camera.CFrame:ToWorldSpace(Settings.snapOffset)
            Settings.isSnapped = false
        end
    else Settings.isSnapped = false end

    -- Auto Fire
    if Settings.AutoFire and target and (tick() - Settings.LastShotTime >= Settings.FIRE_RATE) then
        Settings.LastShotTime = tick()
        local old = Camera.CFrame
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        if mouse1press then mouse1press(); task.wait(0.01); mouse1release() else
            local t = LocalPlayer.Character:FindFirstChildOfClass("Tool"); if t then t:Activate() end
        end
        task.defer(function() Camera.CFrame = old end)
    end
    stroke.Color = target and Color3.new(0,1,0) or Color3.new(0,1,1)
end)

