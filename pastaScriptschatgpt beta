local Mouse = LocalPlayer:GetMouse()
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if self == Mouse and (key == "Hit" or key == "hit") then
        if not checkcaller() and Settings.HeadDownEnabled then
            -- МГНОВЕННО ОТКЛЮЧАЕМ ПОДМЕНУ, ЕСЛИ:
            -- 1. Аимбот видит врага в FOV (Settings.CurrentTarget)
            -- 2. Идет анимация наведения/стабилизации (_prefireActive)
            -- 3. Выполняется функция симуляции клика (IsFiring / isSnapped)
            -- 4. Зажата физическая кнопка мыши (MouseButton1)
            if Settings.IsFiring or Settings.isSnapped or Settings._prefireActive or Settings.CurrentTarget or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                return oldIndex(self, key)
            end
            
            local character = LocalPlayer.Character
            local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))
            
            if root then
                -- Динамический расчет точки на основе ползунка (Settings.HeadDownPitch)
                -- 90 градусов = строго под ноги. 0 градусов = прямо перед собой.
                local angle = math.rad(Settings.HeadDownPitch or 90)
                local forwardComponent = math.cos(angle)
                local downComponent = math.sin(angle)
                
                local targetPos = root.Position + (root.CFrame.LookVector * forwardComponent * 10) - (Vector3.new(0, 1, 0) * downComponent * 10)
                return CFrame.new(targetPos)
            end
        end
    end
    return oldIndex(self, key)
end)

local function DoAutoFire(originalCF)
    if Settings.IsFiring then return end
    Settings.IsFiring = true
    Settings.LastShotTime = tick()

    pcall(function()
        if mouse1click then
            mouse1click()
        elseif mouse1press and mouse1release then
            mouse1press()
            task.wait(0.01)
            mouse1release()
        else
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
        end

        if originalCF and Settings.FixAim then
            Settings.SilentReturnCFrame = originalCF
            Settings.SilentReturnFrames = 3
        end
    end)
    Settings.IsFiring = false
end

task.spawn(function()
    while true do
        task.wait()
        if not Settings.AimbotEnabled then 
            Settings.CurrentTarget = nil 
            continue 
        end

        local mousePos  = UserInputService:GetMouseLocation()
        local bestTarget = nil
        local bestDist   = Settings.FOV_RADIUS
        local bestPartObj = nil

        for _, p in ipairs(Players:GetPlayers()) do
            if p == LocalPlayer then continue end
            if Settings.AimbotTeamCheck and p.Team == LocalPlayer.Team then continue end

            local char = p.Character
            if char and char:FindFirstChildOfClass("Humanoid") and char.Humanoid.Health > 0 then
                local part = getBestPart(char)
                if part then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local mag = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if mag < bestDist then
                            bestDist   = mag
                            bestTarget = p 
                            bestPartObj = part
                        end
                    end
                end
            end
        end

        Settings.CurrentTarget = bestTarget

        if bestTarget and bestPartObj then
            local targetPos = bestPartObj.Position
            local finalLookPos = GetAimLookTarget(targetPos)

            if Settings.AutoFire then
                local stability = Settings.AdaptiveFireEnabled and Settings._adaptiveStability or Settings.ManualStabilityFrames
                if stability > 0 and not Settings.isSnapped then
                    Settings.isSnapped = true
                    for i = 1, stability do RunService.RenderStepped:Wait() end
                end

                if tick() - Settings.LastShotTime >= Settings.FIRE_RATE then
                    local oldCF = Camera.CFrame
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, finalLookPos)
                    DoAutoFire(oldCF)
                end
            else
                Settings.isSnapped = false
                if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, finalLookPos)
                end
            end
        else
            Settings.isSnapped = false
        end
    end
end)

RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    circle.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
    
    UpdateESP()

    if Settings.AdaptiveFireEnabled and Settings.AimbotEnabled and Settings.CurrentTarget then
        local tChar = Settings.CurrentTarget.Character
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
        if tHum then
            if Settings._shotCheckTarget == Settings.CurrentTarget then
                if tHum.Health < Settings._shotCheckHealth and (tick() - Settings._shotCheckTime) < 0.4 then
                    Settings._adaptiveStability = math.clamp(Settings._adaptiveStability - 1, Settings._adaptiveMin, Settings._adaptiveMax)
                    Settings._shotCheckTime = 0
                elseif (tick() - Settings._shotCheckTime) >= 0.4 then
                    Settings._adaptiveStability = math.clamp(Settings._adaptiveStability + 1, Settings._adaptiveMin, Settings._adaptiveMax)
                    Settings._shotCheckTime = tick()
                    Settings._shotCheckHealth = tHum.Health
                end
            else
                Settings._shotCheckTarget = Settings.CurrentTarget
                Settings._shotCheckTime = tick()
                Settings._shotCheckHealth = tHum.Health
            end
            stabilityLabel.Text = "Stability: " .. tostring(Settings._adaptiveStability) .. " frames [auto]"
        end
    elseif not Settings.AdaptiveFireEnabled then
        stabilityLabel.Text = "Stability: " .. tostring(Settings.ManualStabilityFrames) .. " frames [manual]"
    else
        stabilityLabel.Text = "Stability: --"
    end
end)

