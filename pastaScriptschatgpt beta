local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
    return ok, err
end

local function GetAimLookTarget(targetPos)
    if Settings.TP_Enabled then
        local char = LocalPlayer.Character
        local head = char and char:FindFirstChild("Head")
        if head then
            local dir = (targetPos - head.Position).Unit
            return Camera.CFrame.Position + dir * 2000
        end
    end
    return targetPos
end

local function IsVisible(part, targetCharacter)
    if not Settings.AimbotWallCheck then return true end
    local character = LocalPlayer.Character
    if not character or not part or not part.Parent then return false end
    local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    if not head then return false end

    local camOrigin  = Camera.CFrame.Position
    local charOrigin = head.Position
    local targetPos  = part.Position

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    
    local filterInstances = {character, targetCharacter, Camera}
    if ghostFolder then table.insert(filterInstances, ghostFolder) end
    params.FilterDescendantsInstances = filterInstances
    params.IgnoreWater = true

    local resCam = workspace:Raycast(camOrigin, targetPos - camOrigin, params)
    if Settings.FixAim then
        local resChar = workspace:Raycast(charOrigin, targetPos - charOrigin, params)
        return (resCam == nil) and (resChar == nil)
    end
    return resCam == nil
end

local function getBestPart(character)
    if not character then return nil end
    local targetPlayer = Players:GetPlayerFromCharacter(character)
    
    if Settings.BacktrackMaster and targetPlayer and activeGhosts[targetPlayer.Name] then
        local ghostData = activeGhosts[targetPlayer.Name]
        if ghostData and ghostData.model then
            local partName = Settings.TARGET_PART
            if partName ~= "All" and partName ~= "Random" then
                local p = ghostData.model:FindFirstChild(partName)
                if p and IsVisible(p, ghostData.model) then return p end
            elseif partName == "Random" then
                local p = ghostData.model:FindFirstChild(PriorityParts[math.random(1, #PriorityParts)])
                if p and IsVisible(p, ghostData.model) then return p end
            else
                for _, name in ipairs(PriorityParts) do
                    local p = ghostData.model:FindFirstChild(name)
                    if p and IsVisible(p, ghostData.model) then return p end
                end
            end
        end
    end

    local partName = Settings.TARGET_PART
    if partName ~= "All" and partName ~= "Random" then
        local p = character:FindFirstChild(partName)
        if p and IsVisible(p, character) then return p end
    elseif partName == "Random" then
        local p = character:FindFirstChild(PriorityParts[math.random(1, #PriorityParts)])
        if p and IsVisible(p, character) then return p end
    else
        for _, name in ipairs(PriorityParts) do
            local p = character:FindFirstChild(name)
            if p and IsVisible(p, character) then return p end
        end
    end
    return nil
end

local function GetESPData(id)
    if not ESP_CACHE[id] then
        local ok, result = pcall(function()
            return { Name = Drawing.new("Text"), Health = Drawing.new("Text") }
        end)
        if ok then ESP_CACHE[id] = result else return nil end
    end
    return ESP_CACHE[id]
end

local function RemoveESP(id)
    if ESP_CACHE[id] then
        safe(function()
            if ESP_CACHE[id].Name   then ESP_CACHE[id].Name:Remove()   end
            if ESP_CACHE[id].Health then ESP_CACHE[id].Health:Remove()  end
        end)
        ESP_CACHE[id] = nil
    end
end

Players.PlayerRemoving:Connect(function(p)
    RemoveESP(p.Name)
    if activeGhosts[p.Name] then
        if activeGhosts[p.Name].model then activeGhosts[p.Name].model:Destroy() end
        activeGhosts[p.Name] = nil
    end
end)

local function ApplyModelVisuals(model, id, nameTag, color, currentHealth, maxHealth, isGhost)
    if isGhost then
        for _, child in ipairs(model:GetChildren()) do
            if child:IsA("Part") then
                local wp = child:FindFirstChild("WallPierce")
                if wp then
                    wp.Visible = Settings.BacktrackMaster and Settings.BacktrackESP
                    wp.Color3 = Settings.BacktrackColor
                    wp.Transparency = Settings.ChamsTransparency
                end
            end
        end
        return
    end

    local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    local data = GetESPData(id)
    if not data or not head then return end
    local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
    local dist = (Camera.CFrame.Position - head.Position).Magnitude

    if onScreen and dist <= Settings.MaxDistance then
        if Settings.ShowNames then
            data.Name.Text     = nameTag
            data.Name.Position = Vector2.new(pos.X, pos.Y - 30)
            data.Name.Color    = color
            data.Name.Visible  = true
            data.Name.Outline  = true
            data.Name.Size     = 14
        else
            data.Name.Visible = false
        end

        if Settings.ShowHealth and currentHealth then
            data.Health.Text     = "HP: " .. math.floor(currentHealth)
            data.Health.Position = Vector2.new(pos.X, pos.Y - 15)
            data.Health.Color    = Color3.new(1,1,1)
            data.Health.Visible  = true
            data.Health.Outline  = true
            data.Health.Size     = 13
        else
            data.Health.Visible = false
        end

        if Settings.ShowChams then
            local h = model:FindFirstChild("OBKAK_Highlight")
            if not h then
                h = Instance.new("Highlight")
                h.Name = "OBKAK_Highlight"
                h.Parent = model
            end
            h.Enabled          = true
            h.FillColor        = color
            h.FillTransparency = Settings.ChamsTransparency
            h.DepthMode        = Enum.HighlightDepthMode.AlwaysOnTop
        else
            local hl = model:FindFirstChild("OBKAK_Highlight")
            if hl then hl.Enabled = false end
        end
    else
        data.Name.Visible   = false
        data.Health.Visible = false
        local hl = model:FindFirstChild("OBKAK_Highlight")
        if hl then hl.Enabled = false end
    end
end

local function UpdateESP()
    if not Settings.ESPEnabled then
        for id, _ in pairs(ESP_CACHE) do RemoveESP(id) end
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        
        safe(function()
            local char = p.Character
            local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            
            if head and hum and hum.Health > 0 then
                local isTeam = (p.Team == LocalPlayer.Team)
                if Settings.ESPTeamCheck and isTeam then
                    RemoveESP(p.Name)
                    local hl = char:FindFirstChild("OBKAK_Highlight")
                    if hl then hl.Enabled = false end
                else
                    local color = isTeam and Color3.new(0,1,0) or Color3.new(1,0,0)
                    ApplyModelVisuals(char, p.Name, p.Name, color, hum.Health, hum.MaxHealth, false)
                end
            else
                RemoveESP(p.Name)
            end
        end)

        safe(function()
            local ghostData = activeGhosts[p.Name]
            if ghostData and ghostData.model then
                local isTeam = (p.Team == LocalPlayer.Team)
                if Settings.BacktrackMaster and Settings.BacktrackESP and not (Settings.ESPTeamCheck and isTeam) then
                    ApplyModelVisuals(ghostData.model, p.Name .. "_Ghost", "", Settings.BacktrackColor, nil, nil, true)
                else
                    for _, child in ipairs(ghostData.model:GetChildren()) do
                        if child:IsA("Part") then
                            local wp = child:FindFirstChild("WallPierce")
                            if wp then wp.Visible = false end
                        end
                    end
                end
            end
        end)
    end
end

