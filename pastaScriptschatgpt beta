local function CreateSlider(parent, text, minVal, maxVal, default, callback)
    local container = Instance.new("Frame", parent)
    container.Size             = UDim2.new(1, 0, 0, 52)
    container.BackgroundColor3 = C.Card
    container.BorderSizePixel  = 0
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 10)
    Instance.new("UIStroke", container).Color = C.Border

    local lbl = Instance.new("TextLabel", container)
    lbl.Text           = text
    lbl.Size           = UDim2.new(0.6, 0, 0, 18)
    lbl.Position       = UDim2.new(0, 14, 0, 8)
    lbl.TextColor3     = C.TextDim
    lbl.TextSize       = 14
    lbl.Font           = Enum.Font.GothamSemibold
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local valLbl = Instance.new("TextLabel", container)
    valLbl.Text           = tostring(default)
    valLbl.Size           = UDim2.new(0.36, 0, 0, 18)
    valLbl.Position       = UDim2.new(0.64, -14, 0, 8)
    valLbl.TextColor3     = C.Accent
    valLbl.TextSize       = 14
    valLbl.Font            = Enum.Font.GothamBold
    valLbl.BackgroundTransparency = 1
    valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local track = Instance.new("Frame", container)
    track.Size             = UDim2.new(1, -28, 0, 4)
    track.Position         = UDim2.new(0, 14, 0, 36)
    track.BackgroundColor3 = C.SliderOff
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local ratio = math.clamp((default - minVal) / (maxVal - minVal), 0, 1)

    local fill = Instance.new("Frame", track)
    fill.Size             = UDim2.new(ratio, 0, 1, 0)
    fill.BackgroundColor3 = C.Accent
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame", track)
    dot.Size             = UDim2.new(0, 12, 0, 12)
    dot.AnchorPoint      = Vector2.new(0.5, 0.5)
    dot.Position         = UDim2.new(ratio, 0, 0.5, 0)
    dot.BackgroundColor3 = C.White
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local hitbox = Instance.new("TextButton", container)
    hitbox.Size             = UDim2.new(1, -28, 0, 22)
    hitbox.Position          = UDim2.new(0, 14, 0, 26)
    hitbox.BackgroundTransparency = 1
    hitbox.Text             = ""

    local dragging = false
    local function applyVal(sx)
        local rel = math.clamp((sx - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(minVal + (maxVal - minVal) * rel)
        fill.Size     = UDim2.new(rel, 0, 1, 0)
        dot.Position  = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text   = tostring(val)
        safe(callback, val)
    end

    hitbox.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            Settings.IsDraggingSlider = true
            applyVal(inp.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            applyVal(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
            Settings.IsDraggingSlider = false
        end
    end)

    return container
