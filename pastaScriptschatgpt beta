local function createPureR6Model(playerName)
    local model = Instance.new("Model")
    model.Name = playerName .. "_Backtrack"
    
    local r6Parts = {
        {"HumanoidRootPart", Vector3.new(2, 2, 1)},
        {"Torso", Vector3.new(2, 2, 1)},
        {"Head", Vector3.new(1.2, 1.2, 1.2)},
        {"Left Arm", Vector3.new(1, 2, 1)},
        {"Right Arm", Vector3.new(1, 2, 1)},
        {"Left Leg", Vector3.new(1, 2, 1)},
        {"Right Leg", Vector3.new(1, 2, 1)}
    }
    
    for _, partData in ipairs(r6Parts) do
        local p = Instance.new("Part")
        p.Name = partData[1]
        p.Size = partData[2]
        p.CanCollide = false
        p.Anchored = true
        p.Transparency = 1 
        p.Material = Enum.Material.SmoothPlastic
        p.Parent = model
        
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "WallPierce"
        box.Size = p.Size
        box.AlwaysOnTop = true
        box.ZIndex = 5
        box.Color3 = Settings.BacktrackColor
        box.Transparency = 1
        box.Adornee = p
        box.Parent = p
    end
    
    model.PrimaryPart = model:WaitForChild("HumanoidRootPart")
    model.Parent = ghostFolder
    return model
end

local function localAssembleR6(model, baseCFrame)
    model:PivotTo(baseCFrame)
    if model:FindFirstChild("Torso") then model["Torso"].CFrame = baseCFrame end
    if model:FindFirstChild("Head") then model["Head"].CFrame = baseCFrame * CFrame.new(0, 1.5, 0) end
    if model:FindFirstChild("Left Arm") then model["Left Arm"].CFrame = baseCFrame * CFrame.new(-1.5, 0, 0) end
    if model:FindFirstChild("Right Arm") then model["Right Arm"].CFrame = baseCFrame * CFrame.new(1.5, 0, 0) end
    if model:FindFirstChild("Left Leg") then model["Left Leg"].CFrame = baseCFrame * CFrame.new(-0.5, -2, 0) end
    if model:FindFirstChild("Right Leg") then model["Right Leg"].CFrame = baseCFrame * CFrame.new(0.5, -2, 0) end
end

RunService.Heartbeat:Connect(function()
    if not Settings.BacktrackMaster then return end
    local currentTime = os.clock()
    local backtrackLimitSec = Settings.BacktrackMS / 1000
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            
            if root and hum and hum.Health > 0 then
                if not playerHistory[player.Name] then playerHistory[player.Name] = {} end
                
                table.insert(playerHistory[player.Name], {
                    time = currentTime,
                    cframe = root.CFrame
                })
                
                while #playerHistory[player.Name] > 0 and (currentTime - playerHistory[player.Name][1].time) > backtrackLimitSec do
                    table.remove(playerHistory[player.Name], 1)
                end
                
                local history = playerHistory[player.Name]
                local targetTime = currentTime - backtrackLimitSec
                local closestFrame = nil
                local minDiff = math.huge
                
                for _, frame in ipairs(history) do
                    local diff = math.abs(frame.time - targetTime)
                    if diff < minDiff then
                        minDiff = diff
                        closestFrame = frame
                    end
                end
                
                if closestFrame then
                    if not activeGhosts[player.Name] then
                        activeGhosts[player.Name] = { model = createPureR6Model(player.Name), player = player }
                    end
                    
                    local ghostData = activeGhosts[player.Name]
                    if ghostData and ghostData.model then
                        localAssembleR6(ghostData.model, closestFrame.cframe)
                    end
                end
            else
                if activeGhosts[player.Name] then
                    if activeGhosts[player.Name].model then activeGhosts[player.Name].model:Destroy() end
                    activeGhosts[player.Name] = nil
                end
            end
        end
    end
end)

