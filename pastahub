function ESPModule.SetBoxColor(color)
    ESPModule.Config.BOX_COLOR = color
    -- Update existing ESP elements
    for _, esp in pairs(espCache) do
        for _, part in ipairs(esp.elements.bodyParts) do
            if part then
                part.Color3 = color
            end
        end
        if esp.elements.textLabel then
            esp.elements.textLabel.TextStrokeColor3 = color
        end
        if esp.elements.tracer then
            esp.elements.tracer.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, color),
                ColorSequenceKeypoint.new(1, ESPModule.Config.COLORS.ALIVE.SECONDARY)
            })
        end
    end
end

