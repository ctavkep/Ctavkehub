local function CreateSlider(parent, name, min, max, initialValue, valueFormat, callback)
    local setting = Instance.new("Frame")
    setting.Name = name .. "Setting"
    setting.Parent = parent
    setting.Size = UDim2.new(0.9, 0, 0, 70)
    setting.BackgroundColor3 = Color3.fromRGB(20, 30, 60)
    setting.BackgroundTransparency = 0.6
    setting.BorderSizePixel = 0
    setting.ZIndex = 4
    
    local corner = Instance.new("UICorner")
    corner.Parent = setting
    
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Parent = setting
    label.Size = UDim2.new(0.9, 0, 0, 20)
    label.Position = UDim2.new(0.05, 0, 0, 5)
    label.BackgroundTransparency = 1
    label.Text = name .. ": " .. valueFormat(initialValue)
    label.TextColor3 = Color3.fromRGB(220, 230, 255)
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 5
    
    -- Slider track
    local sliderTrack = Instance.new("Frame")
    sliderTrack.Name = "SliderTrack"
    sliderTrack.Parent = setting
    sliderTrack.Size = UDim2.new(0.9, 0, 0, 3)
    sliderTrack.Position = UDim2.new(0.05, 0, 0, 35)
    sliderTrack.BackgroundColor3 = Color3.fromRGB(15, 20, 40)
    sliderTrack.BorderSizePixel = 0
    sliderTrack.ZIndex = 5
    
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = sliderTrack
    
    -- Slider fill
    local sliderFill = Instance.new("Frame")
    sliderFill.Name = "SliderFill"
    sliderFill.Parent = sliderTrack
    sliderFill.Size = UDim2.new((initialValue - min) / (max - min), 0, 1, 0)
    sliderFill.BackgroundColor3 = currentThemeColor
    sliderFill.BorderSizePixel = 0
    sliderFill.ZIndex = 6
    
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = sliderFill
    
    -- Slider thumb
    local sliderThumb = Instance.new("Frame")
    sliderThumb.Name = "SliderThumb"
    sliderThumb.Parent = sliderTrack
    sliderThumb.Size = UDim2.new(0, 9, 0, 9)
    sliderThumb.Position = UDim2.new((initialValue - min) / (max - min), -4.5, 0.5, -4.5)
    sliderThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sliderThumb.BackgroundTransparency = 0.8
    sliderThumb.BorderSizePixel = 0
    sliderThumb.ZIndex = 7
    
    local thumbCorner = Instance.new("UICorner")
    thumbCorner.CornerRadius = UDim.new(1, 0)
    thumbCorner.Parent = sliderThumb
    
    -- Slider functionality
    local dragging = false
    
    local function updateSlider(input)
        local relativeX = (input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X
        relativeX = math.clamp(relativeX, 0, 1)
        
        local newValue = math.floor(min + relativeX * (max - min))
        
        sliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
        sliderThumb.Position = UDim2.new(relativeX, -4.5, 0.5, -4.5)
        label.Text = name .. ": " .. valueFormat(newValue)
        
        if callback then
            callback(newValue)
        end
    end
    
    sliderThumb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)
    
    sliderThumb.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    sliderTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSlider(input)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSlider(input)
        end
    end)
    
    return setting
end

-- API Functions
function NeverloseAPI:CreateTab(tabName)
    if self.Tabs[tabName] then
        return self.Tabs[tabName]
    end
    
    local tab = {
        Name = tabName,
        Elements = {}
    }
    
    self.Tabs[tabName] = tab
    return tab
end

function NeverloseAPI:AddButton(tabName, buttonName, callback)
    if not self.Tabs[tabName] then
        self:CreateTab(tabName)
    end
    
    local tab = self.Tabs[tabName]
    tab.Elements[buttonName] = {
        Type = "Button",
        Callback = callback
    }
    
    return true
end

function NeverloseAPI:AddToggle(tabName, toggleName, defaultValue, callback)
    if not self.Tabs[tabName] then
        self:CreateTab(tabName)
    end
    
    local tab = self.Tabs[tabName]
    tab.Elements[toggleName] = {
        Type = "Toggle",
        Default = defaultValue,
        Callback = callback
    }
    
    return true
end

function NeverloseAPI:AddSlider(tabName, sliderName, min, max, defaultValue, valueFormat, callback)
    if not self.Tabs[tabName] then
        self:CreateTab(tabName)
    end
    
    local tab = self.Tabs[tabName]
    tab.Elements[sliderName] = {
        Type = "Slider",
        Min = min,
        Max = max,
        Default = defaultValue,
        ValueFormat = valueFormat,
        Callback = callback
    }
    
    return true
end

function NeverloseAPI:AddColorPicker(tabName, colorName, defaultColor, callback)
    if not self.Tabs[tabName] then
        self:CreateTab(tabName)
    end
    
    local tab = self.Tabs[tabName]
    tab.Elements[colorName] = {
        Type = "ColorPicker",
        DefaultColor = defaultColor,
        Callback = callback
    }
    
    return true
end

function NeverloseAPI:GetTab(tabName)
    return self.Tabs[tabName]
end

function NeverloseAPI:RemoveElement(tabName, elementName)
    if self.Tabs[tabName] and self.Tabs[tabName].Elements[elementName] then
        self.Tabs[tabName].Elements[elementName] = nil
        return true
    end
    return false
end

function NeverloseAPI:GetConfiguration()
    return {
        OpenCloseBind = currentBind,
        ThemeColor = currentThemeColor,
        Transparency = currentTransparency
    }
end

function NeverloseAPI:SetConfiguration(config)
    if config.OpenCloseBind then
        currentBind = config.OpenCloseBind
    end
    if config.ThemeColor then
        UpdateTheme(config.ThemeColor)
    end
    if config.Transparency then
        UpdateTransparency(config.Transparency)
    end
end

