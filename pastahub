local function updateBodyParts(esp, character)
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local headPart = character:FindFirstChild("Head")
    local torsoPart = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    local leftArmPart = character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")
    local rightArmPart = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
    local leftLegPart = character:FindFirstChild("LeftUpperLeg") or character:FindFirstChild("Left Leg")
    local rightLegPart = character:FindFirstChild("RightUpperLeg") or character:FindFirstChild("Right Leg")
    
    if esp.elements.bodyParts[1] and headPart then
        esp.elements.bodyParts[1].Adornee = headPart
    end
    if esp.elements.bodyParts[2] and torsoPart then
        esp.elements.bodyParts[2].Adornee = torsoPart
    end
    if esp.elements.bodyParts[3] and leftArmPart then
        esp.elements.bodyParts[3].Adornee = leftArmPart
    end
    if esp.elements.bodyParts[4] and rightArmPart then
        esp.elements.bodyParts[4].Adornee = rightArmPart
    end
    if esp.elements.bodyParts[5] and leftLegPart then
        esp.elements.bodyParts[5].Adornee = leftLegPart
    end
    if esp.elements.bodyParts[6] and rightLegPart then
        esp.elements.bodyParts[6].Adornee = rightLegPart
    end
end

local function updateCircleEffect(esp, dt, character)
    esp.circleTime = esp.circleTime + dt * ESPModule.Config.CIRCLE_SPEED
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    local positions = {
        humanoidRootPart.Position + Vector3.new(2, 0, 0),
        humanoidRootPart.Position + Vector3.new(-2, 0, 0),
        humanoidRootPart.Position + Vector3.new(0, 2, 0),
        humanoidRootPart.Position + Vector3.new(0, -1, 0)
    }
    
    for i, circle in ipairs(esp.elements.circles) do
        local pulse = (math.sin(esp.circleTime + i * 0.5) + 1) * 0.5
        circle.Transparency = 0.6 + (pulse * 0.3)
        circle.Radius = 0.6 + pulse * 0.4
        circle.Adornee = nil
        circle.CFrame = CFrame.new(positions[i])
    end
end

local function updatePulseEffect(esp, dt)
    esp.pulseTime = esp.pulseTime + dt * ESPModule.Config.PULSE_SPEED
    
    local pulse = (math.sin(esp.pulseTime) + 1) * 0.5
    
    for _, part in ipairs(esp.elements.bodyParts) do
        if part then
            part.Transparency = ESPModule.Config.TRANSPARENCY - pulse * 0.2
        end
    end
end

local function getDistanceColor(distance)
    local maxDist = ESPModule.Config.MAX_DISTANCE
    local ratio = math.clamp(distance / maxDist, 0, 1)
    
    local r = 0
    local g = 100 + (1 - ratio) * 155
    local b = 150 + (1 - ratio) * 105
    
    return Color3.fromRGB(r, g, b)
end

local function updateESPDisplay(player, esp, distance, isAlive)
    local character = player.Character
    if not character then return end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    updateBodyParts(esp, character)
    
    esp.elements.billboard.Adornee = humanoidRootPart
    
    local primaryColor, accentColor
    if isAlive then
        primaryColor = getDistanceColor(distance)
        accentColor = ESPModule.Config.COLORS.ALIVE.ACCENT
    else
        primaryColor = ESPModule.Config.COLORS.DEAD.PRIMARY
        accentColor = ESPModule.Config.COLORS.DEAD.ACCENT
    end
    
    -- Apply box color
    for i, part in ipairs(esp.elements.bodyParts) do
        if part then
            part.Color3 = ESPModule.Config.BOX_COLOR
        end
    end
    
    for _, circle in ipairs(esp.elements.circles) do
        circle.Color3 = accentColor
    end
    
    esp.elements.tracer.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, ESPModule.Config.BOX_COLOR),
        ColorSequenceKeypoint.new(1, accentColor)
    })
    
    -- Update text based on settings
    local textParts = {}
    
    -- Status (always shown)
    local status = isAlive and "🔵 ALIVE" or "⚪ DEAD"
    table.insert(textParts, status)
    
    -- Name
    if ESPModule.Config.SHOW_NAME then
        table.insert(textParts, "👤 " .. player.Name)
    end
    
    -- Health
    if ESPModule.Config.SHOW_HP and isAlive then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            local healthPercent = math.floor((humanoid.Health / humanoid.MaxHealth) * 100)
            table.insert(textParts, "💙 " .. healthPercent .. "%")
        end
    end
    
    -- Distance - FIXED: Use actual calculated distance
    if ESPModule.Config.SHOW_DISTANCE then
        table.insert(textParts, "📐 " .. math.floor(distance) .. " studs")
    end
    
    -- Set text
    esp.elements.textLabel.Text = table.concat(textParts, "\n")
    esp.elements.textLabel.TextColor3 = ESPModule.Config.TEXT_COLOR
    esp.elements.textLabel.TextSize = ESPModule.Config.TEXT_SIZE
    esp.elements.textLabel.TextStrokeColor3 = ESPModule.Config.BOX_COLOR
    
    -- Update tracer - FIXED: Use LocalPlayer for tracer
    local localPlayer = Players.LocalPlayer
    local localCharacter = localPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    
    if localRoot and isAlive then
        esp.elements.attachment0.Parent = localRoot
        esp.elements.attachment1.Parent = humanoidRootPart
        esp.elements.tracer.Enabled = true
        esp.elements.tracer.Parent = localRoot
    else
        esp.elements.tracer.Enabled = false
        esp.elements.attachment0.Parent = nil
        esp.elements.attachment1.Parent = nil
    end
end

local function updateESP(player, esp, dt)
    local character = player.Character
    if not character or not player.Parent then
        for _, part in ipairs(esp.elements.bodyParts) do
            part.Adornee = nil
        end
        for _, circle in ipairs(esp.elements.circles) do
            circle.Adornee = nil
        end
        esp.elements.billboard.Adornee = nil
        esp.elements.tracer.Enabled = false
        return
    end
    
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then 
        for _, part in ipairs(esp.elements.bodyParts) do
            part.Adornee = nil
        end
        for _, circle in ipairs(esp.elements.circles) do
            circle.Adornee = nil
        end
        esp.elements.billboard.Adornee = nil
        return
    end
    
    local isAlive = checkPlayerState(player)
    esp.isAlive = isAlive
    
    -- FIXED: Calculate distance properly using LocalPlayer
    local localPlayer = Players.LocalPlayer
    local localCharacter = localPlayer.Character
    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
    local distance = 0
    
    if localRoot then
        distance = (humanoidRootPart.Position - localRoot.Position).Magnitude
        if distance > ESPModule.Config.MAX_DISTANCE then
            for _, part in ipairs(esp.elements.bodyParts) do
                part.Adornee = nil
            end
            for _, circle in ipairs(esp.elements.circles) do
                circle.Adornee = nil
            end
            esp.elements.billboard.Adornee = nil
            return
        end
    end
    
    updateESPDisplay(player, esp, distance, isAlive)
    
    if isAlive then
        updatePulseEffect(esp, dt)
        updateCircleEffect(esp, dt, character)
    else
        for _, part in ipairs(esp.elements.bodyParts) do
            part.Transparency = ESPModule.Config.TRANSPARENCY + 0.1
        end
        for _, circle in ipairs(esp.elements.circles) do
            circle.Transparency = 0.9
        end
    end
    
    esp.lastUpdate = tick()
end

local function onPlayerAdded(player)
    if player == Players.LocalPlayer then return end
    
    local connections = {}
    
    connections.characterAdded = player.CharacterAdded:Connect(function(character)
        wait(1)
        if espEnabled then
            local esp = createBodyESP(player)
            esp.lastUpdate = 0
        end
    end)
    
    connections.characterRemoving = player.CharacterRemoving:Connect(function()
        if espCache[player] then
            cleanUpESP(player)
        end
    end)
    
    espPlayerData[player] = {
        connections = connections
    }
    
    if player.Character and espEnabled then
        local esp = createBodyESP(player)
        esp.lastUpdate = 0
    end
end

local function onPlayerRemoving(player)
    cleanUpESP(player)
end

local function startESP()
    if espEnabled then return end
    
    espEnabled = true
    ESPModule.Enabled = true
    
    -- Initialize for existing players
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= Players.LocalPlayer then
            onPlayerAdded(player)
        end
    end
    
    -- Connect events
    playerAddedConnection = Players.PlayerAdded:Connect(onPlayerAdded)
    playerRemovingConnection = Players.PlayerRemoving:Connect(onPlayerRemoving)
    
    -- Start update loop
    espUpdateConnection = RunService.Heartbeat:Connect(function(dt)
        if not espEnabled then return end
        
        for player, esp in pairs(espCache) do
            if player and player.Parent then
                local updateInterval = esp.isAlive and ESPModule.Config.UPDATE_INTERVAL_ALIVE or ESPModule.Config.UPDATE_INTERVAL_DEAD
                
                if tick() - esp.lastUpdate >= updateInterval then
                    updateESP(player, esp, dt)
                end
            else
                cleanUpESP(player)
            end
        end
    end)
end

local function stopESP()
    if not espEnabled then return end
    
    espEnabled = false
    ESPModule.Enabled = false
    
    if espUpdateConnection then
        espUpdateConnection:Disconnect()
        espUpdateConnection = nil
    end
    
    if playerAddedConnection then
        playerAddedConnection:Disconnect()
        playerAddedConnection = nil
    end
    
    if playerRemovingConnection then
        playerRemovingConnection:Disconnect()
        playerRemovingConnection = nil
    end
    
    -- Clean up all ESP and player data
    for player, _ in pairs(espCache) do
        cleanUpESP(player)
    end
    
    for player, _ in pairs(espPlayerData) do
        cleanUpESP(player)
    end
    
    -- Clear data
    espCache = {}
    espPlayerData = {}
end

function ESPModule.Toggle()
    if espEnabled then
        stopESP()
        return false
    else
        startESP()
        return true
    end
end

