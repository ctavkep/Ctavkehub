-- Модуль анимаций
function Modules.Animation.Init()
    local AnimationModule = {
        Settings = NeverloseHub.Settings.Animation,
        IsAnimating = false,
        AnimationTrack = nil,
        CanPlayAnimation = true
    }

    local animation
    local character, humanoid

    local function initializeCharacter()
        character = player.Character or player.CharacterAdded:Wait()
        humanoid = character:WaitForChild("Humanoid")
        
        animation = Instance.new("Animation")
        animation.AnimationId = "rbxassetid://" .. AnimationModule.Settings.AnimationId
    end

    function AnimationModule.PlayAnimation()
        if not AnimationModule.CanPlayAnimation or not AnimationModule.Settings.Enabled then return end
        
        AnimationModule.CanPlayAnimation = false
        
        if AnimationModule.AnimationTrack then
            AnimationModule.AnimationTrack:Stop()
        end
        
        animation.AnimationId = "rbxassetid://" .. AnimationModule.Settings.AnimationId
        
        AnimationModule.AnimationTrack = humanoid:LoadAnimation(animation)
        AnimationModule.AnimationTrack.Priority = Enum.AnimationPriority.Action
        
        AnimationModule.AnimationTrack.Stopped:Connect(function()
            AnimationModule.CanPlayAnimation = true
            AnimationModule.AnimationTrack = nil
        end)
        
        AnimationModule.AnimationTrack:Play()
        return AnimationModule.AnimationTrack
    end

    function AnimationModule.StopAnimation()
        if AnimationModule.AnimationTrack then
            AnimationModule.AnimationTrack:Stop()
            AnimationModule.AnimationTrack = nil
        end
        AnimationModule.CanPlayAnimation = true
    end

    function AnimationModule.StartAnimationLoop()
        if not AnimationModule.IsAnimating then
            AnimationModule.IsAnimating = true
            coroutine.wrap(function()
                while AnimationModule.IsAnimating and character and humanoid and AnimationModule.Settings.Enabled do
                    local track = AnimationModule.PlayAnimation()
                    if track then
                        track.Ended:Wait()
                    else
                        wait(2)
                    end
                end
            end)()
        end
    end

    function AnimationModule.ToggleAnimation()
        if not AnimationModule.IsAnimating then
            AnimationModule.StartAnimationLoop()
            return true
        else
            AnimationModule.IsAnimating = false
            AnimationModule.StopAnimation()
            return false
        end
    end

    function AnimationModule.SetBind(newKeyCode)
        AnimationModule.Settings.Bind = newKeyCode
        NeverloseHub.Settings.Animation.Bind = newKeyCode
    end

    function AnimationModule.SetAnimation(animationId)
        AnimationModule.Settings.AnimationId = animationId
        NeverloseHub.Settings.Animation.AnimationId = animationId
        if AnimationModule.IsAnimating then
            AnimationModule.StopAnimation()
            wait(0.1)
            AnimationModule.PlayAnimation()
        end
    end

    function AnimationModule.SetEnabled(enabled)
        AnimationModule.Settings.Enabled = enabled
        NeverloseHub.Settings.Animation.Enabled = enabled
        if not enabled and AnimationModule.IsAnimating then
            AnimationModule.IsAnimating = false
            AnimationModule.StopAnimation()
        end
    end

    -- Инициализация
    if player.Character then
        initializeCharacter()
    end

    player.CharacterAdded:Connect(function(newCharacter)
        character = newCharacter
        humanoid = character:WaitForChild("Humanoid")
        
        if AnimationModule.IsAnimating then
            wait(1)
            if AnimationModule.IsAnimating then
                AnimationModule.StartAnimationLoop()
            end
        end
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed or not AnimationModule.Settings.Enabled then return end
        
        if input.KeyCode == AnimationModule.Settings.Bind then
            AnimationModule.ToggleAnimation()
        end
    end)

    return AnimationModule
end

