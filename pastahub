-- Библиотека утилит
local Utilities = {
    Math = {
        Round = function(num, decimalPlaces)
            local multiplier = 10^(decimalPlaces or 0)
            return math.floor(num * multiplier + 0.5) / multiplier
        end,
        
        Map = function(value, min1, max1, min2, max2)
            return min2 + (value - min1) * (max2 - min2) / (max1 - min1)
        end,
        
        Clamp = function(value, min, max)
            return math.max(min, math.min(max, value))
        end
    },
    
    String = {
        Split = function(str, separator)
            local parts = {}
            for part in string.gmatch(str, "([^"..separator.."]+)") do
                table.insert(parts, part)
            end
            return parts
        end,
        
        Trim = function(str)
            return string.gsub(str, "^%s*(.-)%s*$", "%1")
        end
    },
    
    Table = {
        DeepCopy = function(tab)
            local copy = {}
            for k, v in pairs(tab) do
                if type(v) == "table" then
                    copy[k] = Utilities.Table.DeepCopy(v)
                else
                    copy[k] = v
                end
            end
            return copy
        end,
        
        Find = function(tab, value)
            for k, v in pairs(tab) do
                if v == value then
                    return k
                end
            end
            return nil
        end
    },
    
    Color = {
        RGBToHSV = function(r, g, b)
            r, g, b = r / 255, g / 255, b / 255
            local max, min = math.max(r, g, b), math.min(r, g, b)
            local h, s, v = 0, 0, max
            
            local d = max - min
            if max == 0 then
                s = 0
            else
                s = d / max
            end
            
            if max == min then
                h = 0
            else
                if max == r then
                    h = (g - b) / d
                    if g < b then
                        h = h + 6
                    end
                elseif max == g then
                    h = (b - r) / d + 2
                elseif max == b then
                    h = (r - g) / d + 4
                end
                h = h / 6
            end
            
            return h, s, v
        end,
        
        HSVToRGB = function(h, s, v)
            local r, g, b
            
            local i = math.floor(h * 6)
            local f = h * 6 - i
            local p = v * (1 - s)
            local q = v * (1 - f * s)
            local t = v * (1 - (1 - f) * s)
            
            i = i % 6
            
            if i == 0 then
                r, g, b = v, t, p
            elseif i == 1 then
                r, g, b = q, v, p
            elseif i == 2 then
                r, g, b = p, v, t
            elseif i == 3 then
                r, g, b = p, q, v
            elseif i == 4 then
                r, g, b = t, p, v
            elseif i == 5 then
                r, g, b = v, p, q
            end
            
            return r * 255, g * 255, b * 255
        end
    }
}

