    }
}

-- Animation variables
local isAnimating = false
local animationTrack = nil
local canPlayAnimation = true
local animation
local character, humanoid

-- Initialize character for animations
local function initializeCharacter()
    character = player.Character or player.CharacterAdded:Wait()
    humanoid = character:WaitForChild("Humanoid")
    
    animation = Instance.new("Animation")
    animation.AnimationId = AnimationModule.Settings.CurrentAnimation
end

-- Animation functions
local function playAnimation()
    if not canPlayAnimation or not AnimationModule.Settings.IsEnabled then return end
    
    canPlayAnimation = false
    
    if animationTrack then
        animationTrack:Stop()
    end
    
    if animation.AnimationId ~= AnimationModule.Settings.CurrentAnimation then
        animation.AnimationId = AnimationModule.Settings.CurrentAnimation
    end
    
    animationTrack = humanoid:LoadAnimation(animation)
    animationTrack.Priority = Enum.AnimationPriority.Action
    
    animationTrack.Stopped:Connect(function()
        canPlayAnimation = true
        animationTrack = nil
    end)
    
    animationTrack:Play()
    return animationTrack
end

local function stopAnimation()
    if animationTrack then
        animationTrack:Stop()
        animationTrack = nil
    end
    canPlayAnimation = true
end

local function startAnimationLoop()
    if not isAnimating then
        isAnimating = true
        coroutine.wrap(function()
            while isAnimating and character and humanoid and AnimationModule.Settings.IsEnabled do
                local track = playAnimation()
                if track then
                    track.Ended:Wait()
                else
                    wait(2)
                end
            end
        end)()
    end
end

function AnimationModule.ToggleAnimation()
    if not isAnimating then
        startAnimationLoop()
        return true
    else
        isAnimating = false
        stopAnimation()
        return false
    end
end

function AnimationModule.SetBind(newKeyCode)
    AnimationModule.Settings.CurrentBind = newKeyCode
end

function AnimationModule.SetAnimation(animationId)
    AnimationModule.Settings.CurrentAnimation = "rbxassetid://" .. tostring(animationId)
    if isAnimating then
        stopAnimation()
        wait(0.1)
        playAnimation()
    end
end

function AnimationModule.SetEnabled(enabled)
    AnimationModule.Settings.IsEnabled = enabled
    if not enabled and isAnimating then
        isAnimating = false
        stopAnimation()
    end
end

-- Initialize animations
