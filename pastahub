-- Модуль интерфейса
function Modules.UI.Init()
    local UIModule = {}
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "NeverloseUI"
    screenGui.Parent = CoreGui
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
    screenGui.ResetOnSpawn = false
    screenGui.Enabled = false

    -- Создание основного окна
    function UIModule.CreateWindow()
        local mainWindow = Instance.new("Frame")
        mainWindow.Name = "MainWindow"
        mainWindow.Parent = screenGui
        mainWindow.AnchorPoint = Vector2.new(0.5, 0.5)
        mainWindow.Position = NeverloseHub.Configuration.WindowPosition
        mainWindow.Size = NeverloseHub.Configuration.WindowSize
        mainWindow.BackgroundColor3 = Color3.fromRGB(10, 15, 30)
        mainWindow.BackgroundTransparency = NeverloseHub.Configuration.Transparency
        mainWindow.BorderSizePixel = 0
        mainWindow.ZIndex = 2

        local mainCorner = Instance.new("UICorner")
        mainCorner.CornerRadius = UDim.new(0, 12)
        mainCorner.Parent = mainWindow

        local mainStroke = Instance.new("UIStroke")
        mainStroke.Parent = mainWindow
        mainStroke.Color = NeverloseHub.Configuration.ThemeColor
        mainStroke.Thickness = 1.5
        mainStroke.Transparency = 0.4

        return mainWindow
    end

    -- Создание вкладки
    function UIModule.CreateTab(parent, name, isFirst)
        local tabFrame = Instance.new("Frame")
        tabFrame.Name = name .. "Tab"
        tabFrame.Parent = parent
        tabFrame.Size = UDim2.new(1, 0, 1, 0)
        tabFrame.BackgroundTransparency = 1
        tabFrame.Visible = isFirst or false
        tabFrame.ZIndex = 3

        return tabFrame
    end

    -- Создание элементов управления
    function UIModule.CreateToggle(parent, config, callback)
        local toggle = Instance.new("Frame")
        toggle.Name = config.Name .. "Toggle"
        toggle.Parent = parent
        toggle.Size = UDim2.new(0.9, 0, 0, 50)
        toggle.BackgroundColor3 = Color3.fromRGB(20, 30, 60)
        toggle.BackgroundTransparency = 0.6
        toggle.BorderSizePixel = 0
        toggle.ZIndex = 4

        local corner = Instance.new("UICorner")
        corner.Parent = toggle

        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Parent = toggle
        label.Size = UDim2.new(0.7, 0, 1, 0)
        label.Position = UDim2.new(0, 15, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = config.Name
        label.TextColor3 = Color3.fromRGB(220, 230, 255)
        label.TextSize = 14
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.ZIndex = 5

        local toggleButton = Instance.new("TextButton")
        toggleButton.Name = "ToggleButton"
        toggleButton.Parent = toggle
        toggleButton.Size = UDim2.new(0, 70, 0, 30)
        toggleButton.Position = UDim2.new(1, -85, 0.5, -15)
        toggleButton.BackgroundColor3 = config.Default and NeverloseHub.Configuration.ThemeColor or Color3.fromRGB(40, 50, 90)
        toggleButton.BackgroundTransparency = 0.5
        toggleButton.Text = config.Default and "ON" or "OFF"
        toggleButton.TextColor3 = config.Default and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 120, 120)
        toggleButton.TextSize = 12
        toggleButton.Font = Enum.Font.GothamBold
        toggleButton.BorderSizePixel = 0
        toggleButton.ZIndex = 5

        local toggleCorner = Instance.new("UICorner")
        toggleCorner.CornerRadius = UDim.new(0, 6)
        toggleCorner.Parent = toggleButton

        toggleButton.MouseButton1Click:Connect(function()
            local newValue = not config.Default
            config.Default = newValue
            
            local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            
            if newValue then
                local tween = TweenService:Create(toggleButton, tweenInfo, {
                    BackgroundColor3 = NeverloseHub.Configuration.ThemeColor,
                    BackgroundTransparency = 0.4,
                    TextColor3 = Color3.fromRGB(255, 255, 255)
                })
                tween:Play()
                toggleButton.Text = "ON"
            else
                local tween = TweenService:Create(toggleButton, tweenInfo, {
                    BackgroundColor3 = Color3.fromRGB(40, 50, 90),
                    BackgroundTransparency = 0.5,
                    TextColor3 = Color3.fromRGB(255, 120, 120)
                })
                tween:Play()
                toggleButton.Text = "OFF"
            end
            
            if callback then
                callback(newValue)
            end
        end)

        return toggle
    end

    function UIModule.CreateSlider(parent, config, callback)
        local slider = Instance.new("Frame")
        slider.Name = config.Name .. "Slider"
        slider.Parent = parent
        slider.Size = UDim2.new(0.9, 0, 0, 70)
        slider.BackgroundColor3 = Color3.fromRGB(20, 30, 60)
        slider.BackgroundTransparency = 0.6
        slider.BorderSizePixel = 0
        slider.ZIndex = 4

        local corner = Instance.new("UICorner")
        corner.Parent = slider

        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.Parent = slider
        label.Size = UDim2.new(0.9, 0, 0, 20)
        label.Position = UDim2.new(0.05, 0, 0, 5)
        label.BackgroundTransparency = 1
        label.Text = config.Name .. ": " .. config.Value
        label.TextColor3 = Color3.fromRGB(220, 230, 255)
        label.TextSize = 14
        label.Font = Enum.Font.Gotham
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.ZIndex = 5

        local sliderTrack = Instance.new("Frame")
        sliderTrack.Name = "SliderTrack"
        sliderTrack.Parent = slider
        sliderTrack.Size = UDim2.new(0.9, 0, 0, 3)
        sliderTrack.Position = UDim2.new(0.05, 0, 0, 35)
        sliderTrack.BackgroundColor3 = Color3.fromRGB(15, 20, 40)
        sliderTrack.BorderSizePixel = 0
        sliderTrack.ZIndex = 5

        local trackCorner = Instance.new("UICorner")
        trackCorner.CornerRadius = UDim.new(1, 0)
        trackCorner.Parent = sliderTrack

        local sliderFill = Instance.new("Frame")
        sliderFill.Name = "SliderFill"
        sliderFill.Parent = sliderTrack
        sliderFill.Size = UDim2.new((config.Value - config.Min) / (config.Max - config.Min), 0, 1, 0)
        sliderFill.BackgroundColor3 = NeverloseHub.Configuration.ThemeColor
        sliderFill.BorderSizePixel = 0
        sliderFill.ZIndex = 6

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = sliderFill

        local sliderThumb = Instance.new("Frame")
        sliderThumb.Name = "SliderThumb"
        sliderThumb.Parent = sliderTrack
        sliderThumb.Size = UDim2.new(0, 9, 0, 9)
        sliderThumb.Position = UDim2.new((config.Value - config.Min) / (config.Max - config.Min), -4.5, 0.5, -4.5)
        sliderThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        sliderThumb.BackgroundTransparency = 0.8
        sliderThumb.BorderSizePixel = 0
        sliderThumb.ZIndex = 7

        local thumbCorner = Instance.new("UICorner")
        thumbCorner.CornerRadius = UDim.new(1, 0)
        thumbCorner.Parent = sliderThumb

        local dragging = false

        local function updateSlider(input)
            local relativeX = (input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X
            relativeX = math.clamp(relativeX, 0, 1)
            
            local newValue = math.floor(config.Min + relativeX * (config.Max - config.Min))
            
            sliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
            sliderThumb.Position = UDim2.new(relativeX, -4.5, 0.5, -4.5)
            label.Text = config.Name .. ": " .. newValue
            
            if callback then
                callback(newValue)
            end
        end

        sliderThumb.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
            end
        end)

        sliderThumb.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)

        sliderTrack.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                updateSlider(input)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                updateSlider(input)
            end
        end)

        return slider
    end

    function UIModule.CreateButton(parent, config, callback)
        local button = Instance.new("TextButton")
        button.Name = config.Name .. "Button"
        button.Parent = parent
        button.Size = UDim2.new(0.9, 0, 0, 40)
        button.Position = UDim2.new(0.05, 0, 0, 0)
        button.BackgroundColor3 = NeverloseHub.Configuration.ThemeColor
        button.BackgroundTransparency = 0.4
        button.Text = config.Name
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        button.TextSize = 14
        button.Font = Enum.Font.GothamBold
        button.BorderSizePixel = 0
        button.ZIndex = 4

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = button

        button.MouseButton1Click:Connect(function()
            if callback then
                callback()
            end
        end)

        return button
    end

    function UIModule.ToggleVisibility()
        screenGui.Enabled = not screenGui.Enabled
    end

    return UIModule
end

