local function CreateToggleSetting(parent, name, initialValue, callback)
    local setting = Instance.new("Frame")
    setting.Name = name .. "Setting"
    setting.Parent = parent
    setting.Size = UDim2.new(0.9, 0, 0, 50)
    setting.BackgroundColor3 = Color3.fromRGB(20, 30, 60)
    setting.BackgroundTransparency = 0.6
    setting.BorderSizePixel = 0
    setting.ZIndex = 4
    
    local corner = Instance.new("UICorner")
    corner.Parent = setting
    
    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Parent = setting
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Position = UDim2.new(0, 15, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = Color3.fromRGB(220, 230, 255)
    label.TextSize = 14
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 5
    
    local toggleButton = Instance.new("TextButton")
    toggleButton.Name = "Toggle"
    toggleButton.Parent = setting
    toggleButton.Size = UDim2.new(0, 70, 0, 30)
    toggleButton.Position = UDim2.new(1, -85, 0.5, -15)
    toggleButton.BackgroundColor3 = initialValue and Color3.fromRGB(0, 120, 255) or Color3.fromRGB(40, 50, 90)
    toggleButton.BackgroundTransparency = 0.5
    toggleButton.Text = initialValue and "ON" or "OFF"
    toggleButton.TextColor3 = initialValue and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 120, 120)
    toggleButton.TextSize = 12
    toggleButton.Font = Enum.Font.GothamBold
    toggleButton.BorderSizePixel = 0
    toggleButton.ZIndex = 5
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(0, 6)
    toggleCorner.Parent = toggleButton
    
    local toggleStroke = Instance.new("UIStroke")
    toggleStroke.Parent = toggleButton
    toggleStroke.Color = Color3.fromRGB(0, 80, 160)
    toggleStroke.Thickness = 1
    toggleStroke.Transparency = 0.6
    
    toggleButton.MouseButton1Click:Connect(function()
        local newValue = not initialValue
        initialValue = newValue
        
        local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        
        if newValue then
            local tween = TweenService:Create(toggleButton, tweenInfo, {
                BackgroundColor3 = Color3.fromRGB(0, 120, 255),
                BackgroundTransparency = 0.4,
                TextColor3 = Color3.fromRGB(255, 255, 255)
            })
            tween:Play()
            toggleButton.Text = "ON"
        else
            local tween = TweenService:Create(toggleButton, tweenInfo, {
                BackgroundColor3 = Color3.fromRGB(40, 50, 90),
                BackgroundTransparency = 0.5,
                TextColor3 = Color3.fromRGB(255, 120, 120)
            })
            tween:Play()
            toggleButton.Text = "OFF"
        end
        
        if callback then
            callback(newValue)
        end
    end)
    
    return setting
end

