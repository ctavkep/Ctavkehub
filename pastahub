-- ESP Functions
local function checkPlayerState(player)
    if not player or not player.Parent then return false end
    local character = player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    return humanoid.Health > 0
end

local function createBodyPart(partType, size, color)
    local part
    if partType == "head" then
        part = Instance.new("SphereHandleAdornment")
        part.Radius = size / 2
    else
        part = Instance.new("BoxHandleAdornment")
        part.Size = size
    end
    part.Name = "ESPPart"
    part.AlwaysOnTop = true
    part.ZIndex = 2
    part.Transparency = ESPModule.Config.TRANSPARENCY
    part.Color3 = color
    return part
end

local function createCircleEffect()
    local circle = Instance.new("SphereHandleAdornment")
    circle.Name = "ESPCircle"
    circle.AlwaysOnTop = false
    circle.ZIndex = 1
    circle.Radius = 0.8
    circle.Transparency = 0.7
    circle.Color3 = ESPModule.Config.COLORS.ALIVE.ACCENT
    return circle
end

local function cleanUpESP(player)
    if espCache[player] then
        for _, element in pairs(espCache[player].elements) do
            if element and element.Parent then
                if type(element) == "table" then
                    for _, subElement in pairs(element) do
                        if subElement and subElement.Parent then
                            subElement:Destroy()
                        end
                    end
                else
                    element:Destroy()
                end
            end
        end
        espCache[player] = nil
    end
    if espPlayerData[player] then
        for _, connection in pairs(espPlayerData[player].connections) do
            if connection then
                connection:Disconnect()
            end
        end
        espPlayerData[player] = nil
    end
end

