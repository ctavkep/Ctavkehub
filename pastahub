-- Theme update functions
local function UpdateTheme(color)
    currentThemeColor = color
    mainStroke.Color = color
    titleLabel.TextColor3 = color
    
    for tabName, indicator in pairs(tabIndicators) do
        if indicator.Visible then
            indicator.BackgroundColor3 = color
        end
    end
end

local function UpdateTransparency(transparency)
    currentTransparency = transparency
    mainWindow.BackgroundTransparency = transparency
    navPanel.BackgroundTransparency = transparency + 0.2
    contentPanel.BackgroundTransparency = transparency + 0.2
end

