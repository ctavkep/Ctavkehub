            function(value) return value .. " studs" end,
            function(value)
                ESPModule.SetMaxDistance(value)
            end)
        
    else
        -- Test setting for other tabs
        CreateToggleSetting(settingsContainer, tabName .. " Test Option", false, function(value)
            -- Do nothing for test options
        end)
    end
    
    tabContents[tabName] = contentFrame
    return contentFrame
end

-- Create navigation buttons function
local function CreateNavButton(buttonName)
    local button = Instance.new("TextButton")
    button.Name = buttonName
    button.Parent = navContainer
    button.Size = UDim2.new(0.9, 0, 0, 48)
    button.BackgroundColor3 = Color3.fromRGB(0, 60, 120)
    button.BackgroundTransparency = 0.7
    button.Text = buttonName
    button.TextColor3 = Color3.fromRGB(180, 220, 255)
    button.TextSize = 14
    button.Font = Enum.Font.Gotham
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.ZIndex = 4

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 8)
    buttonCorner.Parent = button

    local buttonStroke = Instance.new("UIStroke")
    buttonStroke.Parent = button
    buttonStroke.Color = currentThemeColor
    buttonStroke.Thickness = 1
    buttonStroke.Transparency = 0.5
    buttonStroke.LineJoinMode = Enum.LineJoinMode.Round

    local indicator = Instance.new("Frame")
    indicator.Name = "Indicator"
    indicator.Parent = button
    indicator.Size = UDim2.new(0, 4, 0.7, 0)
    indicator.Position = UDim2.new(0, -10, 0.15, 0)
    indicator.BackgroundColor3 = currentThemeColor
    indicator.BorderSizePixel = 0
    indicator.Visible = false
    indicator.ZIndex = 5

    local indicatorCorner = Instance.new("UICorner")
    indicatorCorner.Parent = indicator

    local hoverEffect = Instance.new("Frame")
    hoverEffect.Name = "HoverEffect"
    hoverEffect.Parent = button
    hoverEffect.Size = UDim2.new(1, 0, 1, 0)
    hoverEffect.BackgroundColor3 = Color3.fromRGB(0, 40, 80)
    hoverEffect.BackgroundTransparency = 0.9
    hoverEffect.BorderSizePixel = 0
    hoverEffect.Visible = false
    hoverEffect.ZIndex = 3

    local effectCorner = Instance.new("UICorner")
    effectCorner.Parent = hoverEffect

    -- Hover animations
    local function onHover()
        if currentTab == buttonName then return end
        
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local buttonTween = TweenService:Create(button, tweenInfo, {
            BackgroundColor3 = Color3.fromRGB(0, 100, 200),
            BackgroundTransparency = 0.5,
            TextColor3 = Color3.fromRGB(255, 255, 255)
        })
        
        local strokeTween = TweenService:Create(buttonStroke, tweenInfo, {
            Thickness = 2,
            Transparency = 0.3
        })
        
        hoverEffect.Visible = true
        hoverEffect.BackgroundTransparency = 0.9
        local effectTween = TweenService:Create(hoverEffect, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0.7
        })
        
        buttonTween:Play()
        strokeTween:Play()
        effectTween:Play()
    end

    local function onUnhover()
        if currentTab == buttonName then return end
        
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        local buttonTween = TweenService:Create(button, tweenInfo, {
            BackgroundColor3 = Color3.fromRGB(0, 60, 120),
            BackgroundTransparency = 0.7,
            TextColor3 = Color3.fromRGB(180, 220, 255)
        })
        
        local strokeTween = TweenService:Create(buttonStroke, tweenInfo, {
            Thickness = 1,
            Transparency = 0.5
        })
        
        local effectTween = TweenService:Create(hoverEffect, tweenInfo, {
            BackgroundTransparency = 0.9
        })
        
        buttonTween:Play()
        strokeTween:Play()
        effectTween:Play()
        
        effectTween.Completed:Connect(function()
            if currentTab ~= buttonName then
                hoverEffect.Visible = false
            end
        end)
    end

    button.MouseEnter:Connect(onHover)
    button.MouseLeave:Connect(onUnhover)

    return button, indicator, hoverEffect
end

-- Create tabs in correct order
local tabs = {"RAGE", "VISUALS", "MISC", "CONFIGS", "LUA", "SETTINGS"}

-- Create content for all tabs
for i, tabName in ipairs(tabs) do
    CreateTabContent(tabName)
end

-- Create navigation buttons
for i, tabName in ipairs(tabs) do
    local button, indicator, hoverEffect = CreateNavButton(tabName)
    tabIndicators[tabName] = indicator
    tabHoverEffects[tabName] = hoverEffect
    
    button.MouseButton1Click:Connect(function()
        if currentTab ~= tabName then
            -- Hide previous tab
            if tabContents[currentTab] then
                tabContents[currentTab].Visible = false
            end
            
            -- Reset all indicators
            for tab, ind in pairs(tabIndicators) do
                ind.Visible = false
                if tab ~= tabName then
                    local prevButton = navContainer:FindFirstChild(tab)
                    if prevButton then
                        local resetTween = TweenService:Create(prevButton, 
                            TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                            BackgroundColor3 = Color3.fromRGB(0, 60, 120),
                            BackgroundTransparency = 0.7,
                            TextColor3 = Color3.fromRGB(180, 220, 255)
                        })
                        resetTween:Play()
                        
                        if tabHoverEffects[tab] then
                            tabHoverEffects[tab].Visible = false
                        end
                    end
                end
            end
            
            -- Show active indicator
            indicator.Visible = true
            
            -- Button activation animation
            local buttonTween = TweenService:Create(button, 
                TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = Color3.fromRGB(0, 120, 255),
                BackgroundTransparency = 0.3,
                TextColor3 = Color3.fromRGB(255, 255, 255)
            })
            
            local stroke = button:FindFirstChild("UIStroke")
            if stroke then
                local strokeTween = TweenService:Create(stroke, 
                    TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Thickness = 3,
                    Transparency = 0.2
                })
                strokeTween:Play()
            end
            
            buttonTween:Play()
            
            -- Show hover effect
            hoverEffect.Visible = true
            hoverEffect.BackgroundTransparency = 0.7
            
            -- Show new tab
            currentTab = tabName
            if tabContents[tabName] then
                tabContents[tabName].Visible = true
            end
        end
    end)
    
    -- Activate first tab
    if i == 1 then
        indicator.Visible = true
        button.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
        button.BackgroundTransparency = 0.3
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        if tabContents[tabName] then
            tabContents[tabName].Visible = true
        end
        hoverEffect.Visible = true
        hoverEffect.BackgroundTransparency = 0.7
        
        local stroke = button:FindFirstChild("UIStroke")
        if stroke then
            stroke.Thickness = 3
            stroke.Transparency = 0.2
        end
    end
end

-- Window dragging
local dragging = false
local dragInput, dragStart, startPos

local function update(input)
    local delta = input.Position - dragStart
    mainWindow.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainWindow.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

topBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

