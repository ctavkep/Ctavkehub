-- Menu toggle function
local function ToggleMenu()
    if screenGui.Enabled then
        local closeTween = TweenService:Create(mainWindow, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, 0, 0.4, 0),
            BackgroundTransparency = 1,
            Size = UDim2.new(0, 0, 0, 0)
        })
        closeTween:Play()
        closeTween.Completed:Wait()
        screenGui.Enabled = false
    else
        screenGui.Enabled = true
        mainWindow.Position = UDim2.new(0.5, 0, 0.4, 0)
        mainWindow.BackgroundTransparency = 1
        mainWindow.Size = UDim2.new(0, 0, 0, 0)
        
        local openTween = TweenService:Create(mainWindow, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundTransparency = currentTransparency,
            Size = UDim2.new(0, 650, 0, 500)
        })
        openTween:Play()
    end
end

