    titleLabel.TextSize = 16
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.ZIndex = 1001
    
    -- Сообщение
    local messageLabel = Instance.new("TextLabel")
    messageLabel.Name = "Message"
    messageLabel.Parent = notification
    messageLabel.Size = UDim2.new(1, -20, 0, 40)
    messageLabel.Position = UDim2.new(0, 10, 0, 35)
    messageLabel.BackgroundTransparency = 1
    messageLabel.Text = message
    messageLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    messageLabel.TextSize = 14
    messageLabel.Font = Enum.Font.Gotham
    messageLabel.TextXAlignment = Enum.TextXAlignment.Left
    messageLabel.TextYAlignment = Enum.TextYAlignment.Top
    messageLabel.TextWrapped = true
    messageLabel.ZIndex = 1001
    
    -- Индикатор типа
    local typeIndicator = Instance.new("Frame")
    typeIndicator.Name = "TypeIndicator"
    typeIndicator.Parent = notification
    typeIndicator.Size = UDim2.new(0, 4, 1, 0)
    typeIndicator.Position = UDim2.new(0, 0, 0, 0)
    typeIndicator.BackgroundColor3 = self:GetTypeColor(notificationType)
    typeIndicator.BorderSizePixel = 0
    typeIndicator.ZIndex = 1001
    
    local typeCorner = Instance.new("UICorner")
    typeCorner.CornerRadius = UDim.new(0, 8)
    typeCorner.Parent = typeIndicator
    
    -- Анимация появления
    notification.Position = UDim2.new(1, 300, notification.Position.Y.Scale, notification.Position.Y.Offset)
    local slideIn = TweenService:Create(notification, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(1, -320, notification.Position.Y.Scale, notification.Position.Y.Offset)
    })
    slideIn:Play()
    
    table.insert(self.ActiveNotifications, notification)
    
    -- Автоматическое закрытие
    delay(duration, function()
        self:Remove(notification)
    end)
    
    return notification
end

function NotificationService:GetTypeColor(type)
    local colors = {
        Info = Color3.fromRGB(0, 150, 255),
        Success = Color3.fromRGB(0, 200, 0),
        Warning = Color3.fromRGB(255, 165, 0),
        Error = Color3.fromRGB(255, 50, 50)
    }
    return colors[type] or colors.Info
end

function NotificationService:Remove(notification)
    local index = table.find(self.ActiveNotifications, notification)
    if index then
        table.remove(self.ActiveNotifications, index)
        
        -- Анимация исчезновения
        local slideOut = TweenService:Create(notification, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 300, notification.Position.Y.Scale, notification.Position.Y.Offset)
        })
        slideOut:Play()
        
        slideOut.Completed:Connect(function()
            notification:Destroy()
            self:UpdatePositions()
        end)
    end
end

function NotificationService:UpdatePositions()
    for i, notification in ipairs(self.ActiveNotifications) do
        local newPosition = UDim2.new(1, -320, 1, -100 - ((i-1) * 90))
        local tween = TweenService:Create(notification, TweenInfo.new(0.2), {
            Position = newPosition
        })
        tween:Play()
    end
end

-- Система конфигов
local ConfigService = {
    Configs = {},
    CurrentConfig = "default"
}

function ConfigService:Save(name)
    name = name or self.CurrentConfig
    local configData = {
        HubConfig = Utilities.Table.DeepCopy(NeverloseHub.Configuration),
        Flags = Utilities.Table.DeepCopy(NeverloseHub.Flags)
    }
    
    self.Configs[name] = configData
    
    -- В реальном скрипте здесь будет сохранение в файл
    self:ShowNotification("Конфиг '" .. name .. "' сохранен!")
end

function ConfigService:Load(name)
    if self.Configs[name] then
        local configData = self.Configs[name]
        
        -- Обновляем конфигурацию хаба
        for k, v in pairs(configData.HubConfig) do
            NeverloseHub.Configuration[k] = v
        end
        
        -- Обновляем флаги
        for k, v in pairs(configData.Flags) do
            NeverloseHub.Flags[k] = v
        end
        
        self.CurrentConfig = name
        self:ShowNotification("Конфиг '" .. name .. "' загружен!")
        return true
    else
        self:ShowNotification("Конфиг '" .. name .. "' не найден!", "Error")
        return false
    end
end

function ConfigService:Delete(name)
    if self.Configs[name] then
        self.Configs[name] = nil
        self:ShowNotification("Конфиг '" .. name .. "' удален!")
        return true
    else
        self:ShowNotification("Конфиг '" .. name .. "' не найден!", "Error")
        return false
    end
end

function ConfigService:ShowNotification(message, type)
    if NeverloseHub.Configuration.Notifications then
        NotificationService:Show("Config System", message, type, 3)
    end
end

